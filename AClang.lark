//文法のトップ、全ての入力文字列はここを起点に解析される
?start : cmd+

// 命令の種類
?cmd : out_cmd
     | print_cmd
     | yn_cmd
     | var_cmd
     | add_assign_cmd
     | sub_assign_cmd
     | mul_assign_cmd
     | div_assign_cmd
     | rounddiv_assign_cmd
     | mod_assign_cmd
     | intpow_assign_cmd
     | doublepow_assign_cmd
     | inc_cmd
     | dec_cmd
     | sort_cmd
     | append_cmd
     | if_stmt
     | for_stmt
     | foreach_stmt
     | while_stmt
     | rep_stmt
     | def_stmt
     | return_stmt
     | func_call_cmd // 返り値を使わない関数呼び出し
     | break_stmt
     | continue_stmt

// 命令のルール
// "out"のあとに文が続く
out_cmd : "out" expr_list

print_cmd : "print" expr_list

yn_cmd : "yn" expression -> yn_lower
       | "YN" expression -> yn_upper

// "変数名=" のあとに文が続く
var_cmd : var_list "=" expr_list

add_assign_cmd : primary "+=" expression
sub_assign_cmd : primary "-=" expression
mul_assign_cmd : primary "*=" expression
div_assign_cmd : primary "/=" expression
rounddiv_assign_cmd : primary "/_=" expression
mod_assign_cmd : primary "%=" expression
intpow_assign_cmd : primary "^^=" expression
doublepow_assign_cmd : primary "**=" expression
inc_cmd : primary "++"
dec_cmd : primary "--"

// "sort" または "rsort" のあとに変数名が続く
sort_cmd : "sort" primary  -> sort_asc
         | "rsort" primary -> sort_desc

// 左辺のあとに"<<"が来て右辺が続く
append_cmd : var_name "<<" expression

var_list : var_item ("," var_item)*

// 変数の要素
// 変数そのものと配列アクセスを同じ var_ref にまとめる。
// これにより、a[0] を var_item と atom の2通りに解釈する競合を防ぐ。
?var_item : typed_var
          | var_ref

// 型付き変数
typed_var: var_name ":" var_name

expr_list : expression ("," expression)*

// 文のトップ
?expression : ternary

// 三項演算子
?ternary : logical_or
         | logical_or "?" expression ":" expression -> ternary

// 論理和
?logical_or : logical_or "||" logical_and -> log_or
            | logical_and

// 論理積
?logical_and : logical_and "&&" comparison -> log_and
             | comparison

// 比較演算子
?comparison : comparison "==" add_expr -> eq
            | comparison "!=" add_expr -> neq
            | comparison "<=" add_expr -> lte
            | comparison ">=" add_expr -> gte
            | comparison "<"  add_expr -> lt
            | comparison ">"  add_expr -> gt
            | add_expr

// 四則演算
?add_expr   : add_expr "+" mul_expr -> add
            | add_expr "-" mul_expr -> sub
            | mul_expr  

?mul_expr   : mul_expr "*" pow_expr -> mul
            | mul_expr "/" pow_expr -> div
            | mul_expr "/_" pow_expr -> rounddiv
            | mul_expr "%" pow_expr -> mod
            | pow_expr

// べき乗の優先順位の次を unary_expr に変更
?pow_expr   : unary_expr "^^" pow_expr -> intpow
            | unary_expr "**" pow_expr -> doublepow
            | unary_expr

// 前置演算子（論理否定など）の階層
?unary_expr : "!" unary_expr -> log_not
            | primary

// 配列アクセスは変数参照に限定して扱う。
// 関数呼び出し結果など任意の式への [] は、この文法では扱わない。
?primary    : var_ref
            | atom

// 変数参照（配列アクセスを含む）
?var_ref    : var_name
            | var_ref "[" expression "]" -> vector_access

// 最小単位（リテラル、関数呼び出しなど）
?atom       : STRING -> string
            | NUMBER -> number
            | CHAR -> char
            | "true" -> true_lit
            | "false" -> false_lit
            | func_call // 返り値を使う関数呼び出し
            | "read" "[" expression "]" -> read_vector
            | "iread" "[" expression "]" -> iread_vector
            | "read" -> read_expr
            | "iread" -> iread_expr
            | "modpow" "(" expression "," expression "," expression ")" -> modpow
            | "min" "(" expression ("," expression)* ")" -> min
            | "max" "(" expression ("," expression)* ")" -> max
            | "sum" "(" expression ("," expression)* ")" -> sum
            | "chmin" "(" expression "," expression ")" -> chmin
            | "chmax" "(" expression "," expression ")" -> chmax
            | primary "." "count" "(" expression ")" -> count
            | "(" expression ")"
            | vector_init
            | vector

// 変数名
?var_name : CNAME -> cname

// 配列の初期化
vector_init: "[" expression "]" "*" expression

// 配列(vector)の定義
vector: "[" [expression ("," expression)*] "]"

// ステートメントブロック
block: cmd+

// if文
if_stmt: "if" expression [":"] block ("elif" expression [":"] block)* ["else" [":"] block] "end"

// for文
for_stmt: "for" var_name "in" expression ".." expression [".." expression] [":"] block "end"

// 拡張for文
foreach_stmt: "for" var_name "in" expression [":"] block "end"

// while文
while_stmt: "while" expression [":"] block "end"

// rep文 for i in 0..n を rep i,n と簡潔に書く
rep_stmt: "rep" [var_name ","] expression [":"] block "end"

// 関数定義 def
def_stmt: "def" var_name "(" [def_arg ("," def_arg)*] ")" [":"] block "end"

// return
return_stmt: "return" expression

// 返り値を使う関数呼び出し
// 式である。
func_call: var_name "(" [expression ("," expression)*] ")"

// 返り値を使わない関数呼び出し
// 独立した命令であるため、C++では末尾にセミコロンが付く。
func_call_cmd: func_call

// 引数のルール
?def_arg: typed_var
        | var_name

break_stmt: "break"
continue_stmt: "continue"

// Larkの組み込み正規表現をインポート
%import common.ESCAPED_STRING -> STRING
%import common.CNAME
%import common.WS
%import common.CPP_COMMENT
%import common.C_COMMENT

// 空白文字・コメントを無視
%ignore WS
%ignore CPP_COMMENT
%ignore C_COMMENT

// ドットの後に必ず1文字以上の数字を要求する NUMBER を定義
NUMBER: /[+-]?[0-9]+(\.[0-9]+)?/

// シングルクォート囲みの1文字をパースする正規表現
CHAR: /'([^'\\]|\\.)'/