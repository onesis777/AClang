//文法のトップ、全ての入力文字列はここを起点に解析される
?start : cmd+

// 命令の種類
?cmd : out_cmd
     | var_cmd

// 命令のルール
// "out"のあとに文が続く
out_cmd : "out" expression

// "変数名=" のあとに文が続く
var_cmd : var_name "=" expression

// 文
?expression : expression "+" mul_expr -> add
            | expression "-" mul_expr -> sub
            | mul_expr  

?mul_expr   : mul_expr "*" pow_expr -> mul
            | mul_expr "/" pow_expr -> div
            | mul_expr "/_" pow_expr -> rounddiv
            | mul_expr "%" pow_expr -> mod
            | pow_expr  

?pow_expr   : primary "^^" pow_expr -> intpow
            | primary "^%" expression "%" pow_expr -> modpow
            | primary "**" pow_expr -> doublepow
            | primary

?primary    : STRING -> string
            | NUMBER -> number
            | var_name
            | "read" -> read_expr // str型の入力
            | "iread" -> iread_expr // int型の入力
            | "modpow" "(" expression "," expression "," expression ")" -> modpow
            | "(" expression ")"  // ()は最優先

// 変数名
?var_name : CNAME -> cname

// Larkの組み込み正規表現をインポート
%import common.ESCAPED_STRING -> STRING
%import common.SIGNED_NUMBER  -> NUMBER
%import common.CNAME
%import common.WS
%ignore WS // 空白文字を無視